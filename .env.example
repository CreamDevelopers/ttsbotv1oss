# 必須: Discord Developer Portal で発行した BOT のトークン
DISCORD_TOKEN=

# VOICEVOX エンジンの URL（Docker 版では自動で上書きされます）
VOICEVOX_URL=http://127.0.0.1:50021

# 新しく使い始めた人の声（VOICEVOX のスタイル ID。3 = ずんだもん ノーマル）
DEFAULT_SPEAKER_ID=3

# 1 メッセージで読み上げる最大文字数の初期値（/settings max_length でサーバーごとに変更可）
MAX_MESSAGE_LENGTH=200

# 長文を分割して合成するときの 1 回あたりの文字数
TTS_CHUNK_LENGTH=60

# 接続時の案内に「サポート」ボタンを出したいときに URL を入れる
SUPPORT_URL=

# スラッシュコマンドをすぐ反映したいサーバーの ID（開発用）
DEV_GUILD_ID=

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ffmpeg の場所。見つからないときは起動時に自動でインストールを試みます
FFMPEG_PATH=ffmpeg

DB_PATH=data/bot.db
PRESENCE_INTERVAL=15

# /sound
SOUND_DUCK_VOLUME=0.4
SOUND_MAX_FILE_SIZE_MB=20
SOUND_MAX_DURATION_SECONDS=600

# 地震速報（各サーバーでは /earthquake enable で ON にするまで通知されません）
QUAKE_ENABLED=true
QUAKE_DEFAULT_MIN_SCALE=40
QUAKE_POLL_INTERVAL=30
QUAKE_ALERT_SOUND=assets/alert.mp3
